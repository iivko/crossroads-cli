    "start": "node dist/stdio.js",
    "cli": "node dist/cli.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
