{
  "name": "@crossroads/marketplace-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thin marketplace MCP stdio adapter and CLI",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "marketplace-mcp": "dist/stdio.js",
    "marketplace": "dist/cli.js"
  },
  "scripts": {
